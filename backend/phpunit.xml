<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- BANCO DE TESTE: um Postgres SEPARADO ("mindup_testing"), no mesmo
             servidor do Sail. O RefreshDatabase apaga e recria todas as tabelas
             do banco configurado aqui, por isso o nome NUNCA pode ser o do banco
             de desenvolvimento nem o do Supabase.
             Usuário e senha vêm do .env (a senha não fica neste arquivo). -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="pgsql"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="mindup_testing"/>
        <env name="DB_USERNAME" value="LaravelDockerImagem"/>
        <env name="APP_KEY" value="base64:c0Bfm1zim69yscqWmirGjtmYuLihiFEkFzMptQ7jqMs="/>
        <env name="FILESYSTEM_DISK" value="public"/>
        <env name="FRONTEND_URL" value="http://front.test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
